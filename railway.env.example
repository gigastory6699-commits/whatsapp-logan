# ============================================================
# Railway Environment Variables
# ============================================================
# انسخ هذه المتغيرات في:
# Railway Dashboard > Your Service > Variables > Raw Editor
# ============================================================

# Supabase (مطلوب لحفظ جلسة WhatsApp على Railway)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
USE_SUPABASE_AUTH=true

# API Keys
GROQ_API_KEY=gsk_...
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=ML7jGRDg4E9hIl5qEm1Z
TAVILY_API_KEY=tvly-dev-...
ANTHROPIC_API_KEY=

# Bot Settings
API_KEY=change-this-to-a-secure-random-key
BOT_PHONE_NUMBER=
BOT_LID=

# Features
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_TIME=22:00
SHABBAT_ENABLED=false
SPAM_DETECTION_ENABLED=false
AUTO_PROCESS_JOIN_REQUESTS=false
LOGAN_FREE_CHAT_MODE=true
ENABLE_DM_WEBHOOK=true

# Groups (اتركها فاضية لو بدك تراقب كل الجروبات)
ALLOWED_GROUPS=
AGENT_ADMIN_NUMBERS=
MENTION_ADMIN_NUMBERS=

# Logging
LOG_LEVEL=info

# ملاحظة: API_PORT و PORT بيتحكم فيهم Railway تلقائياً
# ============================================================
